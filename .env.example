# Dados públicos da eleição consultada. Atualize-os a cada ciclo eleitoral do TSE.
NEXT_PUBLIC_TSE_ANO=2026
NEXT_PUBLIC_TSE_ID_ELEICAO=20322002026

# URLs públicas usadas no navegador para buscar fotos e no servidor para consultar dados.
NEXT_PUBLIC_TSE_CANDIDATURA_URL=https://divulgacandcontas.tse.jus.br/divulga/rest/v1/candidatura
NEXT_PUBLIC_TSE_ELEICAO_URL=https://divulgacandcontas.tse.jus.br/divulga/rest/v1/eleicao

# UF selecionada inicialmente e usada como fallback para foto e consulta direta de candidato.
NEXT_PUBLIC_TSE_UF_PADRAO=PR
